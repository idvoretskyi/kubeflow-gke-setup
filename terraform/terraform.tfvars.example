# Copy this file to terraform.tfvars and update with your values.
# Project, region, and zone are auto-detected from gcloud config.

# project_id = "your-gcp-project-id"
# region     = "us-central1"

cluster_name         = "kubeflow-cluster"
release_channel      = "RAPID"
enable_private_nodes = true

# Cost optimization
machine_type       = "e2-standard-4"
spot_instances     = true
min_node_count     = 1
max_node_count     = 10
initial_node_count = 3
disk_size_gb       = 50

# GPU Configuration (Optional)
# enable_gpu       = true
# gpu_type         = "nvidia-tesla-t4"
# gpu_machine_type = "n1-standard-4"

# Master authorized networks — uncomment and add your IP to access the K8s API
# master_authorized_networks = [
#   { cidr_block = "YOUR_IP/32", display_name = "Workstation" }
# ]
